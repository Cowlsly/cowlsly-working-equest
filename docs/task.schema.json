{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowlsly.dev/schemas/durable-task.schema.json",
  "title": "Cowlsly Durable Task",
  "type": "object",
  "required": ["id", "project", "objective", "status", "priority", "acceptance_criteria", "checkpoint", "attempts", "max_attempts"],
  "properties": {
    "id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9._-]+$"},
    "project": {"type": "string", "minLength": 1},
    "repository": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "status": {"enum": ["BLOCKED", "READY", "LEASED", "RUNNING", "REVIEW", "DONE", "FAILED"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "checkpoint": {
      "type": "object",
      "required": ["sequence"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "completed_step": {"type": ["string", "null"]},
        "next_step": {"type": ["string", "null"]},
        "state": {"type": "object"}
      },
      "additionalProperties": false
    },
    "attempts": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "leased_to": {"type": ["string", "null"]},
    "lease_until": {"type": ["string", "null"], "format": "date-time"},
    "heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "artifacts": {"type": "array", "items": {"type": "string"}, "default": []},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
